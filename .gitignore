# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IntelliJ IDEA / JetBrains
.idea/
*.iml
*.ipr
*.iws
out/

# Eclipse / VS Code
.vscode/
.settings/
.project
.classpath
bin/
*.factorypath

# Editor scratch
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Secrets — never commit.
# Signing / release key material must NEVER be committed — the real GPG key + passphrase + Central
# token live only in ~/.gradle/gradle.properties (see RELEASING.md). These broad globs are the
# fail-closed net: they are in place BEFORE any key is generated, so a stray keystore/keyfile in the
# tree is ignored by default rather than accidentally staged.
*.asc
*.gpg
*.key
*.p12
*.pfx
*.jks
*.keystore
*.pem
signing.properties
local.properties
# Generic local-override files (also covers CLAUDE.local.md, kept explicitly below for clarity).
*.local

# Env / local overrides (committed templates use *.example)
.env
.env.*
!.env.example
scripts/planning/cleanroom-patterns.local

# Docker / compose local volumes
example/**/pgdata/

# Obsidian vault config (docs/ is an Obsidian vault; keep notes, not the workspace config)
.obsidian/

# Claude Code local-only files (committed: CLAUDE.md, .claude/settings.json)
CLAUDE.local.md
.claude/settings.local.json
# Skills are local-only — they reference internal projects; kept out of the public repo.
.claude/skills/

# Mulch session (keep the expertise store, ignore the ephemeral session dir)
.mulch/.session/

# Python bytecode (e.g. scripts/postman helpers)
__pycache__/
*.pyc

# Load-testing raw exports (scripts/load/run-load.sh)
scripts/load/results/
