{
  "realm": "catalog-demo",
  "enabled": true,
  "displayName": "Catalog Demo Realm",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "catalog-viewer",
        "description": "Can read catalog resources"
      },
      {
        "name": "catalog-editor",
        "description": "Can modify catalog resources"
      }
    ]
  },
  "clients": [
    {
      "clientId": "catalog-gateway",
      "name": "Catalog API Gateway (APISIX)",
      "description": "Confidential client used by APISIX openid-connect at the gateway.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "catalog-gateway-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:9085/*",
        "/*"
      ],
      "webOrigins": [
        "*"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "catalog-spa",
      "name": "Catalog Demo SPA (browser)",
      "description": "Public client for the browser demo SPA. Authorization Code + PKCE (S256); no secret. The SPA logs in directly against Keycloak, holds the access token, and sends it as a Bearer to the gateway (which validates it, bearer_only). See infra/README.md.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:9085/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:9085"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:9085/*"
      },
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "catalog-directory",
      "name": "Catalog User Directory (service account)",
      "description": "Identity-directory search service account (ADR 0020): client_credentials only, view-users and nothing else. Separate from catalog-gateway so the two trust roles never share a credential. Demo secret, local rig only.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "catalog-directory-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-catalog-directory",
      "enabled": true,
      "serviceAccountClientId": "catalog-directory",
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    },
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
