      "catalogs",
      "{{ae_catalog_id}}"
     ]
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200', () => pm.response.to.have.status(200));",
       "const b = pm.response.json();",
       "pm.test('catalog verb set is exactly [view,update,delete,assign-tags] — taggable catalogs, ADR 0022 (PR #65)', () => {",
       "  pm.expect(b._actions).to.have.all.keys('view','update','delete','assign-tags');",
       "});"
      ]
     }
    }
   ]
  },
  {
   "name": "E7a. Writer GET catalogs LIST -> the governed row carries _actions (multi-root batch, 7.3)",
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{editor_token}}"
     }
    ],
    "url": {
     "raw": "{{gateway}}/api/v1/catalogs?perPage=100",
     "host": [
      "{{gateway}}"
     ],
     "path": [
      "api",
      "v1",
      "catalogs"
     ],
     "query": [
      {
       "key": "perPage",
       "value": "100"
      }
     ]
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200', () => pm.response.to.have.status(200));",
       "const page = pm.response.json();",
       "const row = page.items.find(i => i.id === pm.variables.get('ae_catalog_id'));",
       "pm.test('the governed catalog is on the writer\\'s list (membership is the access path)', () => {",
       "  pm.expect(row, 'the ae catalog row').to.exist;",
       "});",
       "pm.test('the CATALOGS-LIST row carries _actions — the multi-root batch path live (7.3)', () => {",
       "  pm.expect(row._actions, '_actions on the list row').to.exist;",
       "  pm.expect(row._actions.view).to.be.true;",
       "  pm.expect(row._actions.update).to.be.true;",
       "});"
      ]
     }
    }
   ]
  },
  {
   "name": "E7b. Reader GET catalogs LIST -> same row, the honest cut (view:true, update:false)",
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{viewer_token}}"
     }
    ],
    "url": {
     "raw": "{{gateway}}/api/v1/catalogs?perPage=100",
     "host": [
      "{{gateway}}"
     ],
     "path": [
      "api",
      "v1",
      "catalogs"
     ],
     "query": [
      {
       "key": "perPage",
       "value": "100"
      }
     ]
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200', () => pm.response.to.have.status(200));",
       "const page = pm.response.json();",
       "const row = page.items.find(i => i.id === pm.variables.get('ae_catalog_id'));",
       "pm.test('the same endpoint, the reader\\'s CUT: view true, update false (never a copy of the writer\\'s map)', () => {",
       "  pm.expect(row, 'the ae catalog row').to.exist;",
       "  pm.expect(row._actions, '_actions on the list row').to.exist;",
       "  pm.expect(row._actions.view).to.be.true;",
       "  pm.expect(row._actions.update).to.be.false;",
       "});"
      ]
     }
    }
   ]
  }
