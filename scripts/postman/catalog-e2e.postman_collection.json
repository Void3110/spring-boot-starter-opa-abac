{
  "info": {
    "name": "Catalog E2E (via gateway)",
    "description": "End-to-end CRUD over Catalog -> Category -> Product through APISIX, authenticated with a Keycloak token. Runs on BOTH rig flavours: on the OIDC-only quickstart rig (catalog `role-source=demo`) the static supplier grants, and on the user-service rig the suite claims its freshly created catalog with a self-service team first — Slice B4 (ADR 0018) made membership the sole access path, so without that step a catalog is unreachable even by its creator. The runner probes the rig and sets `b4_bootstrap`; the claim step skips itself when it is not set. See docs/guides/E2E-TESTING.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "catalog_id", "value": "" },
    { "key": "category_id", "value": "" },
    { "key": "product_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "1. Auth",
      "description": "Obtain a Keycloak access token. run-tests.sh normally injects access_token (minted in-network); this request documents the grant and works when newman runs on the compose network. See the in-network token caveat in docs/guides/E2E-TESTING.md.",
      "item": [
        {
          "name": "Get token (password grant)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// run-tests.sh mints the token in-network and injects access_token, so this request",
                  "// is normally redundant. When a token is already present, skip the HTTP call entirely",
                  "// (the in-network issuer isn't reachable from the host anyway).",
                  "if (pm.variables.get('access_token')) {",
                  "  console.log('access_token already injected by run-tests.sh; skipping the token request.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Only reached when newman runs ON the compose network (no pre-injected token).",
                  "if (pm.response && pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.test('access_token present', () => pm.expect(json).to.have.property('access_token'));",
                  "  pm.collectionVariables.set('access_token', json.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "client_id", "value": "{{client_id}}" },
                { "key": "client_secret", "value": "{{client_secret}}" },
                { "key": "username", "value": "{{username}}" },
                { "key": "password", "value": "{{password}}" }
              ]
            },
            "url": {
              "raw": "{{keycloak_token_url}}",
              "host": ["{{keycloak_token_url}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Catalog",
      "item": [
        {
          "name": "Create catalog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const c = pm.response.json();",
                  "pm.test('has id', () => pm.expect(c).to.have.property('id'));",
                  "pm.collectionVariables.set('catalog_id', c.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"E2E Catalog\",\n  \"description\": \"created by the e2e suite\"\n}"
            },
            "url": {
              "raw": "{{collection_base_url}}/catalogs",
              "host": ["{{collection_base_url}}"],
              "path": ["catalogs"]
            }
          }
        },
        {
          "name": "Claim the catalog (self-service team) — B4 rigs only",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Slice B4 (ADR 0018) made MEMBERSHIP THE SOLE ACCESS PATH: on the user-service rig a freshly",
                  "// created catalog is unreachable — even by its creator — until a governing team exists. This",
                  "// step is that team, created through the SHIPPED public self-service endpoint (owner-on-create",
                  "// binds the caller), so the suite exercises the real onboarding flow rather than a back door.",
                  "//",
                  "// On the OIDC-only quickstart rig (catalog `role-source=demo`, no user-service) there is no team",
                  "// model at all and the static supplier already grants — so the step is SKIPPED rather than",
                  "// failed. `b4_bootstrap` is set by the runner, which reads the catalog pod's CATALOG_ROLE_SOURCE.",
                  "if (pm.environment.get('b4_bootstrap') !== 'true') { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const team = pm.response.json();",
                  "pm.test('has id', () => pm.expect(team).to.have.property('id'));",
                          "pm.test('the team governs the catalog just created', () => {",
                  "  pm.expect(team.targetType).to.eql('catalog');",
                  "  pm.expect(team.targetId).to.eql(pm.collectionVariables.get('catalog_id'));",
                  "});",
                  "// The owner binding is not visible on this DTO — it is proven by the NEXT request:",
                  "// on a B4 rig 'Get catalog' 200s only because owner-on-create bound the caller."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"E2E lifecycle team\",\n  \"targetType\": \"catalog\",\n  \"targetId\": \"{{catalog_id}}\"\n}"
            },
            "url": {
              "raw": "{{collection_base_url}}/teams",
              "host": [
                "{{collection_base_url}}"
              ],
              "path": [
                "teams"
              ]
            }
          }
        },
        {
          "name": "Get catalog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('id matches', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('catalog_id')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{collection_base_url}}/catalogs/{{catalog_id}}",
              "host": ["{{collection_base_url}}"],
              "path": ["catalogs", "{{catalog_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Category",
      "item": [
        {
          "name": "Create category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const cat = pm.response.json();",
                  "pm.test('catalogId matches', () => pm.expect(cat.catalogId).to.eql(pm.collectionVariables.get('catalog_id')));",
                  "pm.collectionVariables.set('category_id', cat.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"root category\"\n}"
            },
            "url": {
              "raw": "{{collection_base_url}}/catalogs/{{catalog_id}}/categories",
              "host": ["{{collection_base_url}}"],
              "path": ["catalogs", "{{catalog_id}}", "categories"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Product",
      "item": [
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.test('categoryId matches', () => pm.expect(p.categoryId).to.eql(pm.collectionVariables.get('category_id')));",
                  "pm.collectionVariables.set('product_id', p.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop\",\n  \"description\": \"demo product\",\n  \"sku\": \"LAP-001\",\n  \"priceCents\": 129900,\n  \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{collection_base_url}}/catalogs/{{catalog_id}}/categories/{{category_id}}/products",
              "host": ["{{collection_base_url}}"],
              "path": ["catalogs", "{{catalog_id}}", "categories", "{{category_id}}", "products"]
            }
          }
        },
        {
          "name": "Get product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test('id matches', () => pm.expect(p.id).to.eql(pm.collectionVariables.get('product_id')));",
                  "pm.test('fields match what was created', () => {",
                  "  pm.expect(p.name).to.eql('Laptop');",
                  "  pm.expect(p.sku).to.eql('LAP-001');",
                  "  pm.expect(p.priceCents).to.eql(129900);",
                  "  pm.expect(p.currency).to.eql('USD');",
                  "  pm.expect(p.categoryId).to.eql(pm.collectionVariables.get('category_id'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{collection_base_url}}/catalogs/{{catalog_id}}/categories/{{category_id}}/products/{{product_id}}",
              "host": ["{{collection_base_url}}"],
              "path": ["catalogs", "{{catalog_id}}", "categories", "{{category_id}}", "products", "{{product_id}}"]
            }
          }
        },
        {
          "name": "Update product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test('changed fields reflected', () => {",
                  "  pm.expect(p.priceCents).to.eql(99900);",
                  "  pm.expect(p.description).to.eql('on sale');",
                  "});",
                  "pm.test('id unchanged', () => pm.expect(p.id).to.eql(pm.collectionVariables.get('product_id')));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop\",\n  \"description\": \"on sale\",\n  \"sku\": \"LAP-001\",\n  \"priceCents\": 99900,\n  \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{collection_base_url}}/catalogs/{{catalog_id}}/categories/{{category_id}}/products/{{product_id}}",
              "host": ["{{collection_base_url}}"],
              "path": ["catalogs", "{{catalog_id}}", "categories", "{{category_id}}", "products", "{{product_id}}"]
            }
          }
        },
        {
          "name": "List products in category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().items.map(p => p.id);",
                  "pm.test('created product present', () => pm.expect(ids).to.include(pm.collectionVariables.get('product_id')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{collection_base_url}}/catalogs/{{catalog_id}}/categories/{{category_id}}/products",
              "host": ["{{collection_base_url}}"],
              "path": ["catalogs", "{{catalog_id}}", "categories", "{{category_id}}", "products"]
            }
          }
        },
        {
          "name": "Delete product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{collection_base_url}}/catalogs/{{catalog_id}}/categories/{{category_id}}/products/{{product_id}}",
              "host": ["{{collection_base_url}}"],
              "path": ["catalogs", "{{catalog_id}}", "categories", "{{category_id}}", "products", "{{product_id}}"]
            }
          }
        },
        {
          "name": "Get product after delete (403 — the gate denies a missing id, Phase 5.97)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Phase 5.97 (pinned semantic #1): with resource resolution active, a MISSING id behind an",
                  "// annotated resourceId is denied AT THE GATE (resolver empty -> deny) — 403, not the handler's",
                  "// 404 (anti-enumeration; the handler never runs). Pre-5.97 this cell pinned 404.",
                  "pm.test('403 at the gate (missing id; was 404 pre-5.97)', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{collection_base_url}}/catalogs/{{catalog_id}}/categories/{{category_id}}/products/{{product_id}}",
              "host": ["{{collection_base_url}}"],
              "path": ["catalogs", "{{catalog_id}}", "categories", "{{category_id}}", "products", "{{product_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Cleanup",
      "item": [
        {
          "name": "Delete catalog (cascade)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{collection_base_url}}/catalogs/{{catalog_id}}",
              "host": ["{{collection_base_url}}"],
              "path": ["catalogs", "{{catalog_id}}"]
            }
          }
        }
      ]
    }
  ]
}
