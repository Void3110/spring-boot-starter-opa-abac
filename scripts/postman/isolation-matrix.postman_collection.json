{
  "info": {
    "name": "Multi-tenant isolation matrix (Slice B4)",
    "description": "Proves membership is the sole access path + safe self-service through the gateway (ADR 0018/0019). Alice self-onboards (creates a catalog + team, owner-on-create) and sees only hers; a member she adds (Bob) sees only the team's catalog; Carol (multi-team) sees two; Bob cannot deep-link Carol's catalog (403); a squat on Alice's catalog is denied (403). Runs in ORDER \u2014 E2 captures Alice's catalog/team ids into collection variables that E4-E7 reuse.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:9085"
    },
    {
      "key": "collection_base_url",
      "value": "{{gateway}}/api/v1"
    }
  ],
  "item": [
    {
      "name": "E1 \u2014 alice (fresh, no team) GET /catalogs -> []",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{alice_token}}"
          }
        ],
        "url": {
          "raw": "{{collection_base_url}}/catalogs",
          "host": [
            "{{collection_base_url}}"
          ],
          "path": [
            "catalogs"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('E1 200 OK', () => pm.response.to.have.status(200));",
              "const items = pm.response.json().items;",
              "pm.test('E1 alice sees NO catalogs (no realm-fallback leak)', () => pm.expect(items.length).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "E2a \u2014 alice POST /catalogs (201) -> capture id",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{alice_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Alice Co\",\"description\":\"alice self-service catalog\"}"
        },
        "url": {
          "raw": "{{collection_base_url}}/catalogs",
          "host": [
            "{{collection_base_url}}"
          ],
          "path": [
            "catalogs"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('E2a 201 Created (catalog:create via the narrow editor fallback)', () => pm.response.to.have.status(201));",
              "const id = pm.response.json().id;",
              "pm.collectionVariables.set('alice_catalog_id', id);",
              "pm.test('E2a catalog has an id', () => pm.expect(id).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "E2b \u2014 alice POST /teams (her catalog) -> 201, capture team id",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{alice_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Alice Team\",\"targetType\":\"catalog\",\"targetId\":\"{{alice_catalog_id}}\"}"
        },
        "url": {
          "raw": "{{collection_base_url}}/teams",
          "host": [
            "{{collection_base_url}}"
          ],
          "path": [
            "teams"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('E2b 201 Created (alice OWNS the catalog she just created -> ownership check passes)', () => pm.response.to.have.status(201));",
              "const id = pm.response.json().id;",
              "pm.collectionVariables.set('alice_team_id', id);"
            ]
          }
        }
      ]
    },
    {
      "name": "E2c \u2014 alice GET /catalogs -> [her catalog]",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{alice_token}}"
          }
        ],
        "url": {
          "raw": "{{collection_base_url}}/catalogs",
          "host": [
            "{{collection_base_url}}"
          ],
          "path": [
            "catalogs"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('E2c 200 OK', () => pm.response.to.have.status(200));",
              "const ids = pm.response.json().items.map(c => c.id);",
              "pm.test('E2c alice sees exactly her catalog', () => pm.expect(ids).to.eql([pm.collectionVariables.get('alice_catalog_id')]));"
            ]
          }
        }
      ]
    },
    {
      "name": "E3 \u2014 bob (fresh) GET /catalogs -> []",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bob_token}}"
          }
        ],
        "url": {
          "raw": "{{collection_base_url}}/catalogs",
          "host": [
            "{{collection_base_url}}"
          ],
          "path": [
            "catalogs"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('E3 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('E3 bob sees NO catalogs', () => pm.expect(pm.response.json().items.length).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "E4a \u2014 add bob to Alice's team (in-network bootstrap, role=member)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"teamId\":\"{{alice_team_id}}\",\"userId\":\"{{bob_uid}}\",\"roleCode\":\"member\"}"
        },
        "url": {
          "raw": "{{user_service}}/internal/bootstrap/memberships",
          "host": [
            "{{user_service}}"
          ],
          "path": [
            "internal",
            "bootstrap",
            "memberships"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('E4a bob added to Alice team (200)', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "E4b \u2014 bob GET /catalogs -> [Alice's catalog] (scoped access)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bob_token}}"
          }
        ],
        "url": {
          "raw": "{{collection_base_url}}/catalogs",
          "host": [
            "{{collection_base_url}}"
          ],
          "path": [
            "catalogs"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('E4b 200 OK', () => pm.response.to.have.status(200));",
              "const ids = pm.response.json().items.map(c => c.id);",
              "pm.test('E4b bob sees ALICE\\'s catalog (the team\\'s, not his own)', () => pm.expect(ids).to.eql([pm.collectionVariables.get('alice_catalog_id')]));"
            ]
          }
        }
      ]
    },
    {
      "name": "E5a \u2014 add carol to Alice's team (in-network bootstrap, role=member)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"teamId\":\"{{alice_team_id}}\",\"userId\":\"{{carol_uid}}\",\"roleCode\":\"member\"}"
        },
        "url": {
          "raw": "{{user_service}}/internal/bootstrap/memberships",
          "host": [
            "{{user_service}}"
          ],
          "path": [
            "internal",
            "bootstrap",
            "memberships"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('E5a carol added to Alice team (200)', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "E5b \u2014 carol (multi-team) GET /catalogs -> 2 catalogs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{carol_token}}"
          }
        ],
        "url": {
          "raw": "{{collection_base_url}}/catalogs",
          "host": [
            "{{collection_base_url}}"
          ],
          "path": [
            "catalogs"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('E5b 200 OK', () => pm.response.to.have.status(200));",
              "const ids = pm.response.json().items.map(c => c.id);",
              "pm.test('E5b carol sees exactly TWO catalogs (multi-team union)', () => pm.expect(ids.length).to.eql(2));",
              "pm.test('E5b includes her own catalog', () => pm.expect(ids).to.include(pm.variables.get('carol_catalog_id')));",
              "pm.test('E5b includes Alice\\'s catalog', () => pm.expect(ids).to.include(pm.collectionVariables.get('alice_catalog_id')));"
            ]
          }
        }
      ]
    },
    {
      "name": "E6 \u2014 bob (single team) GET Carol's catalog by id -> 403 (no direct-id leak)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bob_token}}"
          }
        ],
        "url": {
          "raw": "{{collection_base_url}}/catalogs/{{carol_catalog_id}}",
          "host": [
            "{{collection_base_url}}"
          ],
          "path": [
            "catalogs",
            "{{carol_catalog_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('E6 bob CANNOT deep-link Carol\\'s catalog (403)', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "E7 \u2014 bob POST /teams targetId=Alice's catalog (squat) -> 403 (ownership)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bob_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Bob squat\",\"targetType\":\"catalog\",\"targetId\":\"{{alice_catalog_id}}\"}"
        },
        "url": {
          "raw": "{{collection_base_url}}/teams",
          "host": [
            "{{collection_base_url}}"
          ],
          "path": [
            "teams"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('E7 bob\\'s squat on Alice\\'s catalog is DENIED (403)', () => pm.response.to.have.status(403));",
              "pm.test('E7 the 403 carries ACCESS_DENIED', () => { const b = pm.response.json(); pm.expect(b.errorCode).to.eql('ACCESS_DENIED'); });"
            ]
          }
        }
      ]
    }
  ]
}
