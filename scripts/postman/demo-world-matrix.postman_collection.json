          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('E31c 200 OK - an untagged catalog needs no second factor', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('E31c exactly one seeded category', () => pm.expect(body.count).to.eql(1));",
                  "pm.test('E31c it is the seeded Demo Open Category', () =>",
