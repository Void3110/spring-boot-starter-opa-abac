    {
      "name": "Convergence",
      "item": [
        {
          "name": "E33a \u2014 CONVERGENCE: after a realm re-import + re-seed, the world is the same world",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sup_token}}"
              }
            ],
            "url": {
              "raw": "{{collection_base_url}}/catalogs?perPage=50",
              "host": [
                "{{collection_base_url}}"
              ],
              "path": [
                "catalogs"
              ],
              "query": [
                {
                  "key": "perPage",
                  "value": "50"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('E33a 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const ids = body.items.map(i => i.id);",
                  "// A re-import can hand every persona a NEW subject. The seed converges anyway: bootstrap/users is",
                  "// find-or-create by subject and the reporting edge is a REPLACE. The runner records whether the",
                  "// subjects were in fact stable (the pinned realm ids) - that is observed, not asserted here.",
                  "pm.test('E33a exactly 2 catalogs again', () => pm.expect(body.count).to.eql(2));",
                  "pm.test('E33a the same two, by exact id', () => {",
                  "  pm.expect(ids).to.include(pm.environment.get('demo_prod_catalog_id'));",
                  "  pm.expect(ids).to.include(pm.environment.get('demo_open_catalog_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E33b \u2014 no duplicate world: pm-demo's page is still exactly two",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pm_token}}"
              }
            ],
            "url": {
              "raw": "{{collection_base_url}}/catalogs?perPage=50",
              "host": [
                "{{collection_base_url}}"
              ],
              "path": [
                "catalogs"
              ],
              "query": [
                {
                  "key": "perPage",
                  "value": "50"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('E33b 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "// A re-seed against a re-imported realm is where duplicate teams/catalogs would appear: a new",
                  "// subject bootstrapping a second app_user, a second Demo * Team governing the same catalog.",
                  "pm.test('E33b exactly 2 rows - no duplicate team or catalog was created', () =>",
                  "  pm.expect(body.count).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "E33c \u2014 and the tier states came back with it",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sup_token}}"
              }
            ],
            "url": {
              "raw": "{{collection_base_url}}/catalogs/{{demo_prod_catalog_id}}/categories",
              "host": [
                "{{collection_base_url}}"
              ],
              "path": [
                "catalogs",
                "{{demo_prod_catalog_id}}",
                "categories"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('E33c 401 - the operator tag survived the re-seed', () => pm.response.to.have.status(401));",
                  "pm.test('E33c with a well-formed challenge', () =>",
                  "  pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('insufficient_user_authentication'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
