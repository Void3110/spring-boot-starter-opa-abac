                  "pm.test('E31c no challenge was issued', () =>",
                  "  pm.expect(pm.response.headers.get('WWW-Authenticate')).to.be.oneOf([undefined, null]));",
                  "pm.collectionVariables.set('observed_open_category_id', body.items[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "E31d \u2014 THE CHALLENGE: sup-demo at aal1 is refused the PRODUCTION catalog's contents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sup_token}}"
              }
            ],
            "url": {
              "raw": "{{collection_base_url}}/catalogs/{{demo_prod_catalog_id}}/categories",
              "host": [
                "{{collection_base_url}}"
              ],
              "path": [
                "catalogs",
                "{{demo_prod_catalog_id}}",
                "categories"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// This is the exact wire condition the console's locked panel is built to consume (RFC 9470).",
                  "pm.test('E31d 401 - a supervised read of production content demands a fresh second factor', () =>",
                  "  pm.response.to.have.status(401));",
                  "const challenge = pm.response.headers.get('WWW-Authenticate');",
                  "pm.test('E31d a WWW-Authenticate challenge is present', () => pm.expect(challenge).to.be.a('string'));",
                  "pm.test('E31d the challenge is a Bearer insufficient_user_authentication', () => {",
                  "  pm.expect(challenge).to.match(/^Bearer /i);",
                  "  pm.expect(challenge).to.include('error=\"insufficient_user_authentication\"');",
                  "});",
                  "pm.test('E31d it names the required acr AND a numeric max_age (both are followable)', () => {",
                  "  const acr = /acr_values=\"([^\"]*)\"/.exec(challenge);",
                  "  const age = /max_age=\"([^\"]*)\"/.exec(challenge);",
                  "  pm.expect(acr, 'acr_values param').to.not.eql(null);",
                  "  pm.expect(acr[1]).to.eql('aal2');",
                  "  pm.expect(age, 'max_age param').to.not.eql(null);",
                  "  pm.expect(Number(age[1])).to.be.a('number').and.to.be.at.least(0);",
                  "});",
                  "pm.test('E31d the body carries the STEP_UP_REQUIRED code the client classifies on', () =>",
                  "  pm.expect(pm.response.json().errorCode).to.eql('STEP_UP_REQUIRED'));"
                ]
              }
            }
          ]
        },
