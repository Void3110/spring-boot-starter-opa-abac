      "catalogs",
      "{{catalog_id}}",
      "categories"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\"name\":\"movable\",\"parentId\":\"{{match_category_id}}\",\"tags\":{\"region\":[\"emea\"]}}"
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('a matching nested placement is allowed', function () { pm.response.to.have.status(201); });",
       "pm.test('the new category sits under the emea category', () => {",
