       "pm.test('the owner still lists exactly the three fixture Categories', () => {",
       "  const names = pm.response.json().items.map(i => i.name);",
       "  pm.expect(names).to.include.members(['EMEA only', 'APAC only', 'EMEA internal']);",
       "  pm.expect(pm.response.json().count).to.eql(3);",
