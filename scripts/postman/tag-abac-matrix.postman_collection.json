     "script": {
      "type": "text/javascript",
      "exec": [
       "// The sharper case: the payload matches the role, the PARENT does not. A creator can read what",
       "// it creates only where it could read — placement is decided on the parent's tags.",
       "pm.test('a matching payload under a mismatching parent is denied', function () { pm.response.to.have.status(403); });",
       "pm.test('403 body is RFC-7807 problem+json with ACCESS_DENIED', () => {",
       "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/problem+json');",
       "  const b = pm.response.json();",
       "  pm.expect(b.errorCode).to.eql('ACCESS_DENIED');",
       "  pm.expect(b.status).to.eql(403);",
       "});"
      ]
     }
    }
   ]
  },
  {
   "name": "7b-ii. … and the apac category holds no product (owner list, exact count)",
   "request": {
