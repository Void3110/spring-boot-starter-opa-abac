      "name": "9. Directory filter: ?subject one-shot lookup -> exactly the owner row (count=1)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{owner_token}}"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/v1/users?subject={{owner_sub}}",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "v1",
            "users"
          ],
          "query": [
            {
              "key": "subject",
              "value": "{{owner_sub}}"
            }
          ]
        }
      },
      "event": [
