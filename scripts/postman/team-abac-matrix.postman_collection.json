{
  "info": {
    "name": "Team-based ABAC matrix (app-resolved roles via the user-service)",
    "description": "Proves the Phase-4 app-resolved path end to end: a catalog request is authorized by a role resolved from real team membership in the user-management-service. The owner of a catalog can write; a member with the viewer role cannot; a member with a team-scoped custom editor role can; a non-member is denied. Roles are resolved by the catalog's HttpRoleDefinitionSupplier calling the user-service; the catalog id (team-target) and the tokens are injected by run-team-matrix.sh after it bootstraps the team data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:9085"
    },
    {
      "key": "user_service",
      "value": "http://localhost:28090"
    },
    {
      "key": "catalog_id",
      "value": ""
    },
    {
      "key": "team_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Owner writes (update the owned catalog) -> 200",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{owner_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/v1/catalogs/{{catalog_id}}",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "v1",
            "catalogs",
            "{{catalog_id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Owner-updated catalog\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('owner may write (role resolved = owner)', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Owner reads -> 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{owner_token}}"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/v1/catalogs/{{catalog_id}}",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "v1",
            "catalogs",
            "{{catalog_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('owner may read', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Viewer-member reads -> 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{viewer_token}}"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/v1/catalogs/{{catalog_id}}",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "v1",
            "catalogs",
            "{{catalog_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('viewer-member may read', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Viewer-member writes -> 403",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{viewer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/v1/catalogs/{{catalog_id}}",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "v1",
            "catalogs",
            "{{catalog_id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Viewer-attempted update\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('viewer-member may NOT write (resolved viewer lacks write)', function () { pm.response.to.have.status(403); });",
              "// [phase-5.9 contract]",
              "pm.test('403 body is RFC-7807 problem+json with ACCESS_DENIED', () => {",
              "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/problem+json');",
              "  const b = pm.response.json();",
              "  pm.expect(b.errorCode).to.eql('ACCESS_DENIED');",
              "  pm.expect(b.status).to.eql(403);",
              "  pm.expect(b).to.have.property('type');",
              "  pm.expect(b).to.have.property('title');",
              "  pm.expect(b).to.not.have.property('message');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Custom-editor member writes -> 200",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{editor_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/v1/catalogs/{{catalog_id}}",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "v1",
            "catalogs",
            "{{catalog_id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Custom-editor update\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('custom-editor member may write (team-scoped custom role grants write)', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Non-member writes -> 403",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{nonmember_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/v1/catalogs/{{catalog_id}}",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "v1",
            "catalogs",
            "{{catalog_id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Non-member update\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('non-member may NOT write (no team -> empty role -> default deny)', function () { pm.response.to.have.status(403); });",
              "// [phase-5.9 contract]",
              "pm.test('403 body is RFC-7807 problem+json with ACCESS_DENIED', () => {",
              "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/problem+json');",
              "  const b = pm.response.json();",
              "  pm.expect(b.errorCode).to.eql('ACCESS_DENIED');",
              "  pm.expect(b.status).to.eql(403);",
              "  pm.expect(b).to.have.property('type');",
              "  pm.expect(b).to.have.property('title');",
              "  pm.expect(b).to.not.have.property('message');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7. Dogfood: owner lists members (team:list-members) -> 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{owner_token}}"
          }
        ],
        "url": {
          "raw": "{{user_service}}/api/v1/teams/{{team_id}}/members",
          "host": [
            "{{user_service}}"
          ],
          "path": [
            "api",
            "v1",
            "teams",
            "{{team_id}}",
            "members"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('owner may list the roster (dogfooded @OpaPreAuthorize, team:list-members)', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "8a. Dogfood: viewer-member lists the roster (team:list-members, Phase 6.7 loosening) -> 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{viewer_token}}"
          }
        ],
        "url": {
          "raw": "{{user_service}}/api/v1/teams/{{team_id}}/members",
          "host": [
            "{{user_service}}"
          ],
          "path": [
            "api",
            "v1",
            "teams",
            "{{team_id}}",
            "members"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Phase 6.7: list-members moved to READ, so any team member (incl. a reader) can see the roster.",
              "pm.test('viewer-member may now list the roster (list-members rides READ)', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Dogfood: viewer-member lists (200) but cannot mutate membership (team:add-member) -> 403",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{viewer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{user_service}}/api/v1/teams/{{team_id}}/members",
          "host": [
            "{{user_service}}"
          ],
          "path": [
            "api",
            "v1",
            "teams",
            "{{team_id}}",
            "members"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"userId\": \"00000000-0000-0000-0000-0000000000aa\", \"roleCode\": \"reader\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Phase 6.7: list-members rides READ, so a viewer-member CAN list the roster now;",
              "// the dogfooded deny is on MUTATION (no CONTROL). The loosening is exactly listing.",
              "pm.test('viewer-member may NOT mutate membership (dogfooded deny)', function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "// [phase-5.9 contract]",
              "pm.test('403 body is RFC-7807 problem+json with ACCESS_DENIED', () => {",
              "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/problem+json');",
              "  const b = pm.response.json();",
              "  pm.expect(b.errorCode).to.eql('ACCESS_DENIED');",
              "  pm.expect(b.status).to.eql(403);",
              "  pm.expect(b).to.have.property('type');",
              "  pm.expect(b).to.have.property('title');",
              "  pm.expect(b).to.not.have.property('message');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
