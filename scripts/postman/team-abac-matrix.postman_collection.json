{
  "info": {
    "name": "Team-based ABAC matrix (app-resolved roles via the user-service)",
    "description": "Proves the Phase-4 app-resolved path end to end: a catalog request is authorized by a role resolved from real team membership in the user-management-service. The owner of a catalog can write; a member with the viewer role cannot; a member with a team-scoped custom editor role can; a non-member is denied. Roles are resolved by the catalog's HttpRoleDefinitionSupplier calling the user-service; the catalog id (team-target) and the tokens are injected by run-team-matrix.sh after it bootstraps the team data. Extended by DIRECTORY-QUERY-FILTERS (Slice 1): the ?subject / ?targetType+?targetId one-shot lookups (matched -> count=1, unmatched -> empty page, half-specified pair -> 400 VALIDATION_FAILED), the bootstrap displayName upsert (re-seed converges on the same row), and the 204-with-JSON-Accept produces fix - each asserting the actual cut (counts, ids, status codes).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:9085"
    },
    {
      "key": "user_service",
      "value": "http://localhost:28090"
    },
    {
      "key": "catalog_id",
      "value": ""
    },
    {
      "key": "team_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Owner writes (update the owned catalog) -> 200",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{owner_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gateway}}/api/v1/catalogs/{{catalog_id}}",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "v1",
            "catalogs",
            "{{catalog_id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Owner-updated catalog\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('owner may write (role resolved = owner)', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
