          "listen": "test",
          "script": {
            "exec": [
              "pm.test('one request answers the subject lookup: count=1, the matching row', function () {",
              "    pm.response.to.have.status(200);",
              "    const page = pm.response.json();",
              "    pm.expect(page.count).to.eql(1);",
              "    pm.expect(page.items).to.have.lengthOf(1);",
              "    pm.expect(page.items[0].subject).to.eql(pm.variables.get('owner_sub'));",
              "    pm.collectionVariables.set('e4_owner_uid', page.items[0].id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
